# ---------------------------------------------------------------------- main

case "${1:-help}" in
  extract)
    require_macos
    [ "$#" -ge 2 ] || die "which package? try: ps4pkg extract \"YourGame.pkg\""
    extract_one "$2" "${3:-}"
    ;;
  batch)
    require_macos
    cmd_batch "${2:-$PWD}"
    ;;
  check)
    require_macos
    cmd_check "${2:-$PWD}"
    ;;
  install | update)
    cmd_install
    ;;
  doctor)
    cmd_doctor
    ;;
  version | --version | -v)
    printf 'ps4pkg %s\n' "$PS4PKG_VERSION"
    ;;
  help | --help | -h)
    cmd_help
    ;;
  *)
    die "unknown command: $1 (try: ps4pkg help)"
    ;;
esac

